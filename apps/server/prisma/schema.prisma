generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  REJECTED
  // Caller ended the call while it was still ringing (distinct from the
  // receiver declining it — REJECTED).
  CANCELLED
  // Receiver already had a different active call in progress; this call was
  // never actually rung.
  BUSY
  MISSED
  ENDED
}

enum CallSource {
  CUSTOMER
  PLAYGROUND
  AI_AGENT
}

enum PlaygroundAttemptType {
  CALL_CREATION
  TURN_CREDENTIAL
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Onboarding: self-reported expected participant-minutes per month.
enum ExpectedUsageRange {
  UNDER_1K
  FROM_1K_TO_10K
  FROM_10K_TO_100K
  OVER_100K
  NOT_SURE
}

// Onboarding: what the customer primarily intends to build.
enum PrimaryUseCase {
  VIDEO_MEETINGS
  CUSTOMER_SUPPORT
  TELEHEALTH
  EDUCATION
  RECRUITMENT
  SALES
  INTERNAL_COMMUNICATION
  OTHER
}

// Subscription lifecycle. PAST_DUE is only ever set on legacy (pre-prepaid)
// rows by the retired dunning flow — prepaid subscriptions never owe money.
enum BillingStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
  SUSPENDED
}

enum PaymentStatus {
  PAID
  FAILED
  PENDING
  REFUNDED
  CANCELLED
  EXPIRED
}

// What a Payment buys. LEGACY = rows created by the retired pay-as-you-go
// flow (card-mandate setup, old minute top-ups).
enum PaymentPurpose {
  SUBSCRIPTION_PURCHASE
  SUBSCRIPTION_RENEWAL
  SUBSCRIPTION_UPGRADE
  TOPUP
  CUSTOM_PLAN
  LEGACY
  // Threshold-triggered prepaid top-up charged against a customer mandate.
  AUTO_TOPUP
}

enum PlanType {
  FREE
  PAID
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
  CUSTOM
}

enum PlanCtaAction {
  SIGNUP
  CHECKOUT
  CONTACT_SALES
}

enum CreditTransactionType {
  SUBSCRIPTION_ALLOCATION
  USAGE_DEBIT
  TOPUP_PURCHASE
  ADMIN_ADJUSTMENT
  REFUND
  EXPIRATION
  PROMOTION
  MIGRATION
}

enum CreditBucketSource {
  SUBSCRIPTION
  TOPUP
  PROMOTION
  ADMIN
  MIGRATION
}

enum TopUpStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TopUpExpiryPolicy {
  NEVER
  DAYS
  SUBSCRIPTION_END
}

enum CreditPricingStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

enum CustomPlanRequestStatus {
  NEW
  CONTACTED
  NEGOTIATING
  PROPOSAL_SENT
  ACCEPTED
  REJECTED
  CLOSED
}

enum CustomPlanOfferStatus {
  SENT
  ACCEPTED
  WITHDRAWN
  EXPIRED
}

enum AuditAction {
  USER_REGISTERED
  PROJECT_CREATED
  API_KEY_GENERATED
  PLAN_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESUMED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RESUMED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_METHOD_REMOVED
  PAYMENT_METHOD_UPDATED
  DISCOUNT_CREATED
  DISCOUNT_UPDATED
  DISCOUNT_DISABLED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_ARCHIVED
  TOPUP_PACKAGE_CREATED
  TOPUP_PACKAGE_UPDATED
  FEATURE_UPDATED
  BILLING_CONFIG_UPDATED
  CREDITS_ADJUSTED
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_DOWNGRADE_SCHEDULED
  PAYMENT_REFUNDED
  TOPUP_PURCHASED
  CUSTOM_PLAN_REQUESTED
  CUSTOM_PLAN_REQUEST_UPDATED
  CUSTOM_PLAN_OFFER_CREATED
  CUSTOM_PLAN_OFFER_WITHDRAWN
  LEGACY_BILLING_MIGRATED
  CREDIT_PRICING_DRAFT_CREATED
  CREDIT_PRICING_DRAFT_UPDATED
  CREDIT_PRICING_PUBLISHED
  CREDIT_PRICING_SCHEDULED
  CREDIT_PRICING_CANCELLED
  PROMOTIONAL_CREDITS_GRANTED
  AUTO_TOPUP_ENABLED
  AUTO_TOPUP_UPDATED
  AUTO_TOPUP_DISABLED
  PREPAID_ACCESS_CHANGED
  CREDIT_PURCHASE_BLOCK_CHANGED
}

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  googleId         String? @unique
  name             String?
  avatarUrl        String?
  passwordHash     String?
  refreshTokenHash String?

  role   UserRole   @default(USER)
  // Admin tab access: { [tab]: "READ" | "WRITE" }. null = full access.
  // See src/admin/admin-access.ts.
  adminPermissions Json?
  status UserStatus @default(ACTIVE)
  phone  String?

  // Business profile, collected once during onboarding right after the
  // first Google sign-in (see AuthService.updateProfile). `jobTitle` is the
  // person's self-described role — distinct from `role`, which is the
  // system permission level. `country` is an ISO 3166-1 alpha-2 code.
  companyName        String?
  jobTitle           String?
  country            String?
  companyWebsite     String?
  expectedUsageRange ExpectedUsageRange?
  primaryUseCase     PrimaryUseCase?
  // Backend-controlled gate: false until the required onboarding fields
  // have been submitted and validated. Login routes to the dashboard only
  // once this is true.
  profileCompleted   Boolean             @default(false)

  // Razorpay customer (also lets Checkout offer the customer's saved cards).
  razorpayCustomerId String?
  // LEGACY (pay-as-you-go): card-mandate token from the retired monthly
  // auto-charge. Kept until the customer removes it — never charged by the
  // prepaid billing flow.
  razorpayTokenId    String?
  cardBrand          String?
  cardLast4          String?
  cardExpMonth       Int?
  cardExpYear        Int?
  // LEGACY: post-paid spending cap. Retained for history, no longer enforced
  // (prepaid credits are the usage control now).
  spendingLimitPaise Int?

  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects             Project[]
  auditLogs            AuditLog[]
  subscriptions        Subscription[]
  usages               Usage[]
  usageInvoices        UsageInvoice[]
  prorationAdjustments ProrationAdjustment[]
  customerDiscounts    CustomerDiscount[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  notifications        Notification[]
  creditWallet         CreditWallet?
  creditTransactions   CreditTransaction[]
  payments             Payment[]
  customPlanRequests   CustomPlanRequest[]   @relation("CustomPlanRequestCustomer")
  assignedPlanRequests CustomPlanRequest[]   @relation("CustomPlanRequestAssignee")
  customPlanOffers     CustomPlanOffer[]
  privatePlans         Plan[]                @relation("PrivatePlanAssignee")

  translationRateOverride TranslationRateOverride?

  // Prepaid billing: first verified credit purchase (or admin approval).
  // Unlocks BillingConfig.prepaidFeatures on top of plan features.
  prepaidSince          DateTime?
  // Admin block on paid credit purchases and Auto Top-Up.
  creditPurchaseBlocked Boolean   @default(false)
  autoTopUpSetting      AutoTopUpSetting?
}

// A customer's plan subscription. Prepaid: a paid row only becomes ACTIVE
// once its Payment is verified (see BillingFulfillmentService). Commercial
// terms are snapshotted here at purchase time so later admin edits to the
// Plan never change what this customer bought.
//
// Rows created before the prepaid migration were billing-cycle anchors for
// the retired pay-as-you-go model (planId null until migrated); their
// dunning fields are kept for history only.
model Subscription {
  id                 String        @id @default(uuid())
  companyId          String
  company            User          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status             BillingStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // LEGACY: fixed day-of-month of the retired pay-as-you-go cycle.
  billingAnchorDay   Int?
  cancelAtPeriodEnd  Boolean       @default(false)
  // LEGACY dunning state (pay-as-you-go). Never set by prepaid billing.
  gracePeriodEndsAt  DateTime?
  dunningAttempts    Int           @default(0)
  paymentFailedAt    DateTime?

  // ── Purchased terms (snapshot) ──
  planId               String?
  plan                 Plan?            @relation(fields: [planId], references: [id])
  planVersionId        String?
  planVersion          PlanVersion?     @relation(fields: [planVersionId], references: [id])
  planName             String?
  planType             PlanType?
  pricePaise           Int              @default(0)
  currency             String           @default("INR")
  includedCredits      Int              @default(0)
  billingInterval      BillingInterval?
  intervalCount        Int              @default(1)
  // { features: string[], mediaCredits: {...} } at purchase.
  entitlementsSnapshot Json?

  activatedAt              DateTime?
  expiredAt                DateTime?
  canceledAt               DateTime?
  // Downgrade chosen by the customer: applies when the current period ends.
  scheduledPlanId          String?
  // Upgrade chain: the subscription this one replaced, and vice versa.
  previousSubscriptionId   String?
  replacedBySubscriptionId String?
  // Set by the one-off prepaid migration (e.g. "legacy_payg").
  migrationSource          String?

  // ── Auto-renew (provider-managed recurring mandate) ──
  // When on, the payment provider charges the customer at each period end
  // under an e-mandate they authorized (card / UPI Autopay); our server only
  // extends the plan after a verified charge webhook. Off = manual renewal.
  autoRenew                  Boolean   @default(false)
  providerSubscriptionId     String?   @unique
  // Provider's mandate state: created | authenticated | active | pending | halted | cancelled | completed
  providerSubscriptionStatus String?
  // Version the mandate will charge for at the next renewal (price change or
  // scheduled downgrade); null = the current snapshot.
  renewalPlanVersionId       String?
  // Total (incl. GST, after discount) the mandate is set up to charge.
  renewalAmountPaise         Int?
  autoRenewChangedAt         DateTime?
  // Why auto-renew was switched off by the system (halted, price change failed…).
  autoRenewOffReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      Payment[]
  invoices      Invoices[]
  usage         Usage[]
  creditBuckets CreditBucket[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([status, currentPeriodEnd])
}

// One checkout: a plan purchase/renewal/upgrade, a credit top-up or a custom
// plan purchase. Amounts are computed server-side from the database — never
// taken from the browser. Paid rows double as receipts (receiptNumber).
model Payment {
  id             String         @id @default(uuid())
  // Null for top-ups and legacy rows without a subscription.
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  purpose        PaymentPurpose @default(LEGACY)

  provider               String  @default("razorpay")
  // Unique so a retried webhook / duplicate callback can never fulfill twice.
  providerOrderId        String? @unique
  providerPaymentId      String? @unique
  // Set when this payment is a charge on an auto-renew mandate.
  providerSubscriptionId String?

  // Totals (paise). `amount` = what the customer pays (incl. tax).
  amount          Int           @default(0)
  subtotalPaise   Int           @default(0)
  discountPaise   Int           @default(0)
  discountPercent Int?
  taxPercent      Int           @default(0)
  taxPaise        Int           @default(0)
  currency        String        @default("INR")
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?

  // What was bought (snapshot).
  planVersionId  String?
  topUpPackageId String?
  customOfferId  String?
  credits        Int     @default(0)
  // Immutable per-credit quote snapshot; null for legacy and package payments.
  creditPricingVersionId String?
  creditPricePaise       Int?
  creditExpiryAt         DateTime?
  quoteExpiresAt         DateTime?
  description    String?
  // [{ label, amountPaise, credits? }] as shown at checkout.
  lineItems      Json?

  receiptNumber Int?      @unique
  failureReason String?
  refundedPaise Int       @default(0)
  refundedAt    DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  attempts PaymentAttempt[]

  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([providerSubscriptionId])
}

// Immutable after publication. Drafts are editable; a published version
// supplies the authoritative rate and purchase policy for future quotes.
model CreditPricingVersion {
  id                        String              @id @default(uuid())
  version                   Int
  currency                  String              @default("INR")
  creditPricePaise          Int
  minimumPurchasePaise      Int                 @default(100000)
  maximumPurchasePaise      Int?
  minimumCredits            Int                 @default(1)
  maximumCredits            Int?
  purchasedValidityDays     Int                 @default(365)
  autoTopUpEnabled          Boolean             @default(false)
  autoTopUpMinimumPaise     Int                 @default(100000)
  autoTopUpMaximumPaise     Int?
  monthlyAutoTopUpLimitPaise Int?
  promotionalPolicy         Json?
  effectiveAt               DateTime            @default(now())
  status                    CreditPricingStatus @default(DRAFT)
  createdById               String
  publishedById             String?
  createdAt                 DateTime            @default(now())
  publishedAt               DateTime?
  updatedAt                 DateTime            @updatedAt

  @@unique([currency, version])
  @@index([currency, status, effectiveAt])
  @@index([createdAt])
}

// Each provider payment attempt against a Payment's order (a customer can
// fail once and retry inside the same Checkout).
model PaymentAttempt {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerPaymentId String   @unique
  status            String // captured | authorized | failed
  method            String?
  errorCode         String?
  errorDescription  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentId])
}

// Every verified provider webhook, keyed by the provider's event id so a
// redelivered event is processed exactly once.
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model Usage {
  id                String        @id @default(uuid())
  companyId         String
  company           User          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingCycleStart DateTime
  billingCycleEnd   DateTime
  minutesUsed       Int           @default(0)
  minutesPurchased  Int           @default(0)
  callsCreated      Int           @default(0)
  callsCompleted    Int           @default(0)
  participants      Int           @default(0)
  apiRequests       Int           @default(0)

  // ── Metered participant-minutes by media type ──
  // Stored as Float (not rounded) so credit consumption stays accurate to
  // the second; round only when displaying to users.
  audioMinutes       Float @default(0)
  videoMinutes       Float @default(0)
  screenShareMinutes Float @default(0)
  // LEGACY: rated cost in paise from the pay-as-you-go model.
  usageCostPaise     Int   @default(0)
  // Credits consumed in this period (prepaid model).
  creditsUsed        Int   @default(0)

  createdAt DateTime @default(now())

  callUsage CallUsage[]

  @@unique([companyId, billingCycleStart])
}

// LEGACY: pay-as-you-go per-minute rates + free allowances. Still read to
// render historical usage invoices and as the internal cost basis in admin
// analytics; customer-facing billing uses BillingConfig credit rates.
model BillingRate {
  id               String   @id @default(uuid())
  key              String   @unique // e.g. "default"
  audioPaise       Int      @default(20) // ₹0.20 / participant-minute
  videoPaise       Int      @default(80) // ₹0.80 / participant-minute
  screenSharePaise Int      @default(10) // +₹0.10 / participant-minute (add-on to video)
  freeAudioMins    Int      @default(500) // Developer Free Tier audio allowance
  freeVideoMins    Int      @default(200) // Developer Free Tier video allowance
  taxPercent       Int      @default(18) // GST
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

// Admin-assigned, customer-specific commercial discount (e.g. a negotiated
// volume deal). Applied only when computing THAT customer's invoice subtotal
// — never changes the global BillingRate, and never touches recorded usage.
// Only one row may be `active` per companyId at a time (enforced in
// CustomerDiscountService, not a DB constraint, so replacing a discount can
// deactivate the old row while preserving it for invoice-history audit — see
// UsageInvoice.discountPercent/discountPaise, which snapshot the discount
// actually applied at generation time so past invoices never change if this
// record is later edited or disabled).
model CustomerDiscount {
  id             String    @id @default(uuid())
  companyId      String
  company        User      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  percentage     Int // 0-100 inclusive; 0 = no discount, 100 = fully free
  active         Boolean   @default(true)
  effectiveFrom  DateTime
  // null = continues indefinitely until an admin disables it.
  effectiveUntil DateTime?
  reason         String?
  // Admin user id who created/last replaced this discount. Denormalized for
  // quick display — the authoritative audit trail is AuditLog (actorId),
  // which properly relates to User.
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, active])
}

// Per-call billing line item (call analytics + invoicing).
model CallUsage {
  id                 String    @id @default(uuid())
  usageId            String
  usage              Usage     @relation(fields: [usageId], references: [id], onDelete: Cascade)
  callId             String
  audioMinutes       Float     @default(0)
  videoMinutes       Float     @default(0)
  screenShareMinutes Float     @default(0)
  participants       Int       @default(0)
  // LEGACY: rated paise cost (internal cost basis).
  costPaise          Int       @default(0)
  // Credits charged for this call (prepaid model).
  creditsCharged     Int       @default(0)
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())

  @@index([usageId])
  // TODO(billing): promote to @@unique([callId]) once the pre-existing
  // duplicate CallUsage rows in this DB are cleaned up manually — Postgres
  // will refuse to add a unique constraint while duplicates exist. Until
  // then, idempotency relies on CallService.endCall's atomic status-transition
  // claim plus UsageBillingService.recordCallUsage's existence check.
  @@index([callId])
}

model Invoices {
  id                String       @id @default(uuid())
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  razorpayPaymentId String?
  invoiceNumber     String?
  hostedInvoiceUrl  String?
  invoicePdf        String?
  amount            Int          @default(0)
  currency          String       @default("INR")
  status            String       @default("open")
  generatedAt       DateTime?
  paidAt            DateTime?

  createdAt DateTime @default(now())
}

// LEGACY: month-end post-paid usage invoice from the retired pay-as-you-go
// model. No new rows are created; kept so historical invoices keep rendering.
model UsageInvoice {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleStart         DateTime
  cycleEnd           DateTime
  invoiceNumber      String?
  razorpayPaymentId  String?
  razorpayOrderId    String?
  // Line-item totals (paise)
  audioMinutes       Int       @default(0)
  videoMinutes       Int       @default(0)
  screenShareMinutes Int       @default(0)
  audioPaise         Int       @default(0)
  videoPaise         Int       @default(0)
  screenSharePaise   Int       @default(0)
  subtotalPaise      Int       @default(0)
  // Customer-specific discount snapshot — persisted at generation time so
  // this invoice's history is immutable even if the customer's discount is
  // later changed or disabled (see CustomerDiscount). null = no discount was
  // active for this customer as of this cycle's start.
  discountPercent    Int?
  discountPaise      Int       @default(0)
  discountReason     String?
  taxPaise           Int       @default(0)
  totalPaise         Int       @default(0)
  currency           String    @default("INR")
  status             String    @default("open") // open | processing | paid | failed | dunning
  dueAt              DateTime?
  paidAt             DateTime?
  // Dunning retry scheduling (fixed day-1/3/7 schedule from dunningStartedAt).
  dunningStartedAt   DateTime?
  nextRetryAt        DateTime?
  retryCount         Int       @default(0)
  createdAt          DateTime  @default(now())

  lineItems UsageInvoiceLineItem[]

  @@unique([userId, cycleStart])
}

// Staging table for upgrade/downgrade proration: one row per pending
// credit/charge to be folded into the customer's next UsageInvoice, then
// marked consumed. Deliberately not a full running-balance ledger — see
// plan doc for rationale.
model ProrationAdjustment {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPaise       Int // signed: negative = credit, positive = additional charge
  reason            String
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  consumedInvoiceId String?

  @@index([userId, consumedAt])
}

model UsageInvoiceLineItem {
  id           String       @id @default(uuid())
  invoiceId    String
  invoice      UsageInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  callId       String?
  mediaType    String // audio | video | screen_share
  minutes      Int          @default(0)
  participants Int          @default(0)
  amountPaise  Int          @default(0)
  createdAt    DateTime     @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

// Outbound webhook delivery attempts (retry/backoff + dead-letter tracking).
model WebhookDelivery {
  id        String   @id @default(uuid())
  callId    String
  event     String
  url       String
  status    String   @default("pending") // pending | delivered | failed
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callId])
  @@index([status])
}

// Server-wide platform settings (maintenance mode, announcements, etc.).
model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum ProjectTheme {
  LIGHT
  DARK
}

model Project {
  id String @id @default(uuid())

  name String

  description String?

  ownerId String

  owner User @relation(fields: [ownerId], references: [id])

  apiKeys ApiKey[]

  calls Call[]

  aiAgents AiAgent[]

  translationSettings TranslationSettings?
  translationLexicons TranslationLexicon[]

  webhookUrl    String?
  webhookSecret String?

  // ── Hosted UI branding ──────────────────────────────
  companyName  String?
  logoUrl      String?
  primaryColor String       @default("#2563EB")
  theme        ProjectTheme @default(DARK)
  waitingRoom  Boolean      @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model ApiKey {
  id String @id @default(uuid())

  // SHA-256 hex digest of the raw key — the raw key is shown to the user
  // exactly once at creation and never stored or returned again. Auth looks
  // up by this hash, not by the plaintext key.
  keyHash String @unique

  // First ~12 chars of the raw key (e.g. "bj_live_a1b2"), stored only for
  // masked display in the dashboard ("bj_live_a1b2••••••••").
  keyPrefix String

  name String

  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model Call {
  id String @id @default(uuid())

  projectId String

  project Project @relation(fields: [projectId], references: [id])

  callerId String

  receiverId String

  // Display identity passed by the integrating app at call creation — the
  // customer's backend owns its own users; PurpleCallio only transports/shows
  // what it's given for the call UI (incoming-call screen, etc.).
  callerName     String?
  callerAvatar   String?
  receiverName   String?
  receiverAvatar String?

  type CallType

  status CallStatus @default(INITIATED)

  source          CallSource @default(CUSTOMER)
  expiresAt       DateTime?
  maxParticipants Int?
  creatorIdentity String?
  creatorIpKey    String?

  // ── Live Translate ──────────────────────────────────
  // BCP-47-ish language per participant ("auto" = detect). Null = not set.
  callerLanguage    String?
  receiverLanguage  String?
  translationMode   TranslationMode @default(OFF)
  // lexiconId, context, maxMinutes, guard, onLimit, postCallReport (see
  // translation/translation-config.ts for the validated shape).
  translationConfig Json?

  startedAt DateTime?

  endedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  events              CallEvent[]
  usageSegments       UsageSegment[]
  session             CallSession?
  aiSession           AiCallSession?
  translationSessions TranslationSession[]
  translationPhrases  TranslationPhrase[]
  translationReport   TranslationReport?

  @@index([source, status, expiresAt])
  @@index([source, status, createdAt])
}

model PlaygroundAttempt {
  id          String                @id @default(uuid())
  identityKey String
  ipKey       String
  type        PlaygroundAttemptType @default(CALL_CREATION)
  createdAt   DateTime              @default(now())

  @@index([identityKey, createdAt])
  @@index([ipKey, createdAt])
  @@index([createdAt])
  @@index([identityKey, ipKey, type, createdAt])
}

// A time-bounded interval of a call with a homogeneous media state and a
// fixed set of participants. Built from the call's event stream, then rated
// per participant-minute. This is how telecom billing works: events →
// segments → money.
model UsageSegment {
  id                 String   @id @default(uuid())
  callId             String
  call               Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  endedAt            DateTime
  participantCount   Int      @default(0)
  // Aggregate "does ANY participant have this on" flags — display-only
  // (timeline badges). Billing must NOT be derived from these; see `participants`.
  audio              Boolean  @default(false)
  video              Boolean  @default(false)
  screenShare        Boolean  @default(false)
  // Per-participant media state snapshot for this segment:
  // [{ participantId, audio, video, screenShare }, ...]. This is the actual
  // billing basis — each participant is rated individually so e.g. one
  // participant having video on doesn't charge video minutes for everyone.
  participants       Json     @default("[]")
  // Rated fractional participant-minutes for this segment (not rounded).
  audioMinutes       Float    @default(0)
  videoMinutes       Float    @default(0)
  screenShareMinutes Float    @default(0)
  // Rated cost in paise for this segment (after free-allowance application).
  costPaise          Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([callId, startedAt])
}

model CallEvent {
  id String @id @default(uuid())

  callId String

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  event String

  participantId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([callId, createdAt])
}

model CallSession {
  id String @id @default(uuid())

  callId String @unique

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  callerToken   String @unique
  receiverToken String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum SupportTicketType {
  GENERAL
  CUSTOM_PLAN
}

enum SupportSenderType {
  CUSTOMER
  ADMIN
}

// Customer-raised integration/development support request. Deliberately
// minimal: no priority, assignment, tags or SLA.
model SupportTicket {
  id                    String              @id @default(uuid())
  // Human-friendly number shown as "PC-<ticketNumber>". Backed by a Postgres
  // sequence (starts at 1001, see migration) so concurrent creates can never
  // collide — no read-then-increment race.
  ticketNumber          Int                 @unique @default(autoincrement())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject               String
  type                  SupportTicketType   @default(GENERAL)
  // Slug of the related public docs page (e.g. "react" -> /docs/react).
  documentationId       String?
  status                SupportTicketStatus @default(OPEN)
  // Unread tracking: each side's newest message vs. when that side last
  // opened the ticket. The admin side is shared by all admins — any admin
  // opening the ticket marks it read for the support team.
  lastCustomerMessageAt DateTime?
  lastAdminMessageAt    DateTime?
  customerLastReadAt    DateTime?
  adminLastReadAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  messages          SupportMessage[]
  customPlanRequest CustomPlanRequest?

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id         String            @id @default(uuid())
  ticketId   String
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType SupportSenderType
  message    String
  createdAt  DateTime          @default(now())

  @@index([ticketId, createdAt])
}

// Only events PurpleCallio actually emits today — add a value here when a
// new feature starts calling NotificationService.createNotification.
enum NotificationType {
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLY
  SUPPORT_TICKET_STATUS_CHANGED
  // LEGACY (pay-as-you-go) — kept so existing rows stay valid.
  USAGE_LIMIT_APPROACHING
  USAGE_LIMIT_REACHED
  INVOICE_GENERATED
  INVOICE_PAYMENT_SUCCESS
  INVOICE_PAYMENT_FAILED
  // Prepaid billing
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PLAN_ACTIVATED
  PLAN_EXPIRING
  PLAN_EXPIRED
  CREDITS_LOW
  CREDITS_EXHAUSTED
  TOPUP_SUCCESS
  CUSTOM_PLAN_REQUEST_CREATED
  CUSTOM_PLAN_OFFER_RECEIVED
  API_KEY_CREATED
  API_KEY_REVOKED
  PROJECT_CREATED
  TRANSLATION_BUDGET_THRESHOLD
  TRANSLATION_RATE_CHANGED
  TRANSLATION_REPORT_READY
  CREDITS_EXPIRING
  AUTO_TOPUP_SCHEDULED
  AUTO_TOPUP_SUCCEEDED
  AUTO_TOPUP_FAILED
}

// Which area a notification belongs to: the customer dashboard or the admin
// portal. Keeps admin operational alerts out of an admin's own customer
// notifications (and vice versa).
enum NotificationAudience {
  CUSTOMER
  ADMIN
}

// In-app notification. Created only via NotificationService.
model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  NotificationAudience @default(CUSTOMER)
  type      NotificationType
  title     String
  message   String
  read      Boolean              @default(false)
  // Small context for click-through navigation (ticketId, invoiceId, ...).
  metadata  Json?
  // Stable identity of the underlying event (e.g. "invoice-generated:<id>",
  // "usage:<usageId>:video:80"). Unique per user so an event processed
  // twice (webhook retry, cron overlap) can never notify twice. Null for
  // events that are inherently one-off.
  dedupeKey String?
  createdAt DateTime             @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, audience, createdAt])
  @@index([userId, audience, read])
}

// ─────────────────────────────────────────────────────────────────────────
// Prepaid billing: plans, credits, top-ups, custom plans
// ─────────────────────────────────────────────────────────────────────────

// A sellable plan. Display fields live here and may be edited freely;
// commercial terms (price, credits, media caps, features) live on immutable
// PlanVersion rows so editing a plan never changes an existing purchase.
model Plan {
  id               String        @id @default(uuid())
  slug             String        @unique
  name             String
  description      String?
  badge            String?
  // Retained for compatibility with existing databases; new plan pricing uses PlanVersion.
  compareAtPricePaise Int?
  type             PlanType
  status           PlanStatus    @default(ACTIVE)
  displayOrder     Int           @default(0)
  isPopular        Boolean       @default(false)
  isPublic         Boolean       @default(true)
  // Private custom plans are offered to exactly one customer.
  assignedUserId   String?
  assignedUser     User?         @relation("PrivatePlanAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  ctaLabel         String?
  ctaAction        PlanCtaAction @default(CHECKOUT)
  currentVersionId String?       @unique
  currentVersion   PlanVersion?  @relation("PlanCurrentVersion", fields: [currentVersionId], references: [id])
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  versions      PlanVersion[]     @relation("PlanVersions")
  subscriptions Subscription[]
  offers        CustomPlanOffer[]

  @@index([status, isPublic, displayOrder])
}

// Immutable commercial terms of a plan at a point in time.
model PlanVersion {
  id                         String          @id @default(uuid())
  planId                     String
  plan                       Plan            @relation("PlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  version                    Int
  pricePaise                 Int             @default(0)
  currency                   String          @default("INR")
  billingInterval            BillingInterval @default(MONTH)
  // Interval multiplier; for CUSTOM it is the number of days.
  intervalCount              Int             @default(1)
  // Credits granted per billing period.
  includedCredits            Int             @default(0)
  // Optional per-media caps within includedCredits (null = no cap).
  includedAudioCredits       Int?
  includedVideoCredits       Int?
  includedScreenShareCredits Int?
  // Feature registry keys (see Feature).
  features                   String[]        @default([])
  createdById                String?
  createdAt                  DateTime        @default(now())

  currentOf     Plan?             @relation("PlanCurrentVersion")
  subscriptions Subscription[]
  offers        CustomPlanOffer[]

  @@unique([planId, version])
}

// Central feature registry. Code checks entitlements by `key` (see
// EntitlementService); admins manage labels/visibility here.
model Feature {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  category     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  // Shown in the public comparison table.
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Singleton (key = "default") billing configuration, editable by admins.
model BillingConfig {
  id                          String            @id @default(uuid())
  key                         String            @unique @default("default")
  // Credits per participant-minute, by media type.
  audioCreditsPerMinute       Int               @default(1)
  videoCreditsPerMinute       Int               @default(4)
  screenShareCreditsPerMinute Int               @default(1)
  // Credits per minute of an AI voice agent call (whole call, not per participant).
  aiCreditsPerMinute          Int               @default(15)
  // ── Live Translate (admin-managed) ─────────────────
  // Credits per translated participant-minute (per listener direction).
  translationVoiceCreditsPerMinute      Int     @default(450)
  translationCaptionsCreditsPerMinute   Int     @default(60)
  // Optional separate voice rate for Indian-language routes (null = use the voice rate).
  translationIndicVoiceCreditsPerMinute Int?
  // Credits needed to start translation (null = one minute of the chosen mode).
  translationMinimumCredits             Int?
  // One-time free translated minutes for accounts whose plan lacks TRANSLATION.
  translationTrialMinutes               Int     @default(0)
  // Post-Call Suite report charge (per report).
  postCallReportCredits                 Int     @default(100)
  // Provider cost in paise per direction-minute, by route (margin reporting only).
  translationProviderCostsPaise         Json    @default("{\"openai-translate\":300,\"sarvam-voice\":150,\"sarvam-captions\":50,\"mock\":0}")
  // Admin warning when a route's gross margin drops below this %.
  translationMarginWarnPercent          Int     @default(40)
  // Default per-call limit and project budget bounds.
  translationDefaultMaxMinutes          Int     @default(60)
  translationMaxBudgetCredits           Int     @default(10000000)
  // GST applied on top of plan / top-up prices at checkout.
  taxPercent                  Int               @default(18)
  // % of period credits used that trigger a notification.
  lowCreditThresholds         Int[]             @default([80, 90, 100])
  // New calls need at least this many available credits.
  minimumCreditsToStartCall   Int               @default(1)
  topUpExpiryPolicy           TopUpExpiryPolicy @default(NEVER)
  topUpExpiryDays             Int?
  // Days before expiry to remind the customer to renew.
  renewalReminderDays         Int               @default(7)
  // ── Prepaid model ──────────────────────────────────
  // Features unlocked for accounts with User.prepaidSince set.
  prepaidFeatures             String[]          @default(["HOSTED_UI", "WEBRTC_SDK", "REST_API", "REACT_COMPONENTS", "SCREEN_SHARING", "WEBHOOKS", "ANALYTICS", "CUSTOM_BRANDING", "TRANSLATION"])
  // Days before a credit lot expires to notify the customer.
  creditExpiryReminderDays    Int[]             @default([30, 7, 1])
  // Auto Top-Up: bounded retries for transient failures only.
  autoTopUpMaxRetries         Int               @default(2)
  autoTopUpRetryDelayHours    Int               @default(6)
  // Minimum gap between two successful auto top-ups for one account.
  autoTopUpCooldownMinutes    Int               @default(30)
  // Unpaid checkouts are abandoned after this many hours.
  pendingCheckoutTtlHours     Int               @default(24)
  // Auto-renew checkbox pre-ticked at checkout.
  autoRenewDefault            Boolean           @default(true)
  // How long an auto-renewing plan stays active past its period end while
  // the provider's renewal charge is pending/retrying.
  autoRenewGraceHours         Int               @default(72)
  // Free accounts must be explicitly enabled for paid credit purchases.
  freeAccountsCanPurchaseCredits Boolean        @default(false)
  freeAccountsCanUseAutoTopUp Boolean           @default(false)
  updatedById                 String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
}

model CreditWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sum of all non-expired buckets' remaining credits. Only ever changed by
  // CreditService inside a transaction holding this row's lock.
  balance   Int      @default(0)
  // Held for in-flight operations (available = balance - reserved).
  reserved  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buckets      CreditBucket[]
  transactions CreditTransaction[]
}

// A grant of credits with its own expiry, so expiring one grant can never
// take credits from another.
model CreditBucket {
  id             String             @id @default(uuid())
  walletId       String
  wallet         CreditWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  source         CreditBucketSource
  initialAmount  Int
  remaining      Int
  expiresAt      DateTime?
  expiredAt      DateTime?
  subscriptionId String?
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  referenceType  String?
  referenceId    String?
  createdAt      DateTime           @default(now())

  @@index([walletId, remaining])
  @@index([expiresAt, remaining])
  @@index([subscriptionId])
}

// Immutable ledger: one row per credit change.
model CreditTransaction {
  id             String                @id @default(uuid())
  walletId       String
  wallet         CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           CreditTransactionType
  // Signed: positive = credit, negative = debit.
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  bucketId       String?
  referenceType  String?
  referenceId    String?
  // Unique per logical event (e.g. "usage:<callId>") — the double-apply guard.
  idempotencyKey String?               @unique
  metadata       Json?
  actorId        String?
  createdAt      DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
}

model TopUpPackage {
  id           String      @id @default(uuid())
  name         String
  description  String?
  pricePaise   Int
  currency     String      @default("INR")
  credits      Int
  status       TopUpStatus @default(ACTIVE)
  displayOrder Int         @default(0)
  isPopular    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model CustomPlanRequest {
  id                      String                  @id @default(uuid())
  userId                  String
  user                    User                    @relation("CustomPlanRequestCustomer", fields: [userId], references: [id], onDelete: Cascade)
  ticketId                String                  @unique
  ticket                  SupportTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status                  CustomPlanRequestStatus @default(NEW)
  assignedAdminId         String?
  assignedAdmin           User?                   @relation("CustomPlanRequestAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  // Admin's working notes, e.g. estimated monthly usage.
  notes                   String?
  estimatedMonthlyCredits Int?
  requestedAt             DateTime                @default(now())
  closedAt                DateTime?
  updatedAt               DateTime                @updatedAt

  offers CustomPlanOffer[]

  @@index([userId, status])
  @@index([status, requestedAt])
}

// A private custom plan offered to one customer. Accepting it starts a
// normal checkout; the plan activates only after verified payment.
model CustomPlanOffer {
  id            String                @id @default(uuid())
  requestId     String?
  request       CustomPlanRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan                  @relation(fields: [planId], references: [id])
  planVersionId String
  planVersion   PlanVersion           @relation(fields: [planVersionId], references: [id])
  status        CustomPlanOfferStatus @default(SENT)
  message       String?
  expiresAt     DateTime?
  acceptedAt    DateTime?
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId, status])
}

// Provider-side recurring plan (e.g. a Razorpay Plan) for one exact charge
// amount + interval. Reused by every mandate with the same terms.
model ProviderPlan {
  id              String          @id @default(uuid())
  provider        String
  providerPlanId  String          @unique
  amountPaise     Int
  currency        String
  billingInterval BillingInterval
  intervalCount   Int
  createdAt       DateTime        @default(now())

  @@unique([provider, amountPaise, currency, billingInterval, intervalCount])
}

// ── AI Voice Agents ────────────────────────────────────

enum AiAgentStatus {
  ACTIVE
  DISABLED
}

enum AiToolMethod {
  POST
  GET
}

model AiAgent {
  id String @id @default(uuid())

  // Owner is project.ownerId — the same ownership model API keys use.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      AiAgentStatus @default(ACTIVE)

  // Plain id (no FK, to avoid a cyclic relation) of one of this agent's
  // versions. Config edits create a new version and move this pointer.
  currentVersionId String?

  storeTranscript         Boolean @default(false)
  // null | 7 | 30 | 90
  transcriptRetentionDays Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions AiAgentVersion[]
  tools    AiAgentTool[]
  sessions AiCallSession[]

  @@index([projectId, deletedAt])
}

/// Immutable snapshot of an agent's call configuration.
model AiAgentVersion {
  id String @id @default(uuid())

  agentId String
  agent   AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  version            Int
  instructions       String
  welcomeMessage     String?
  language           String  @default("en")
  voice              String?
  provider           String  @default("gemini")
  model              String?
  maxDurationSeconds Int

  createdAt DateTime @default(now())

  @@unique([agentId, version])
}

model AiAgentTool {
  id String @id @default(uuid())

  agentId String
  agent   AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name                 String
  description          String
  parametersSchema     Json
  endpointUrl          String
  method               AiToolMethod @default(POST)
  enabled              Boolean      @default(true)
  requiresConfirmation Boolean      @default(false)
  timeoutMs            Int          @default(8000)

  // Generated server-side; returned to the customer only once, on create.
  signingSecret String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, name])
}

enum AiSessionStatus {
  CREATED
  CONNECTING
  ACTIVE
  ENDED
  FAILED
  EXPIRED
}

/// One AI voice call. Owns the browser token and, later, provider usage.
/// Never has CallSession / CallUsage rows: AI calls stay out of the
/// human-call billing path.
model AiCallSession {
  id String @id @default(uuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  agentId        String
  agent          AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersionId String
  projectId      String
  ownerId        String

  // SHA-256 of the bj_ai_ token; the raw token is returned once.
  tokenHash String @unique

  provider          String
  model             String?
  providerSessionId String?

  status             AiSessionStatus @default(CREATED)
  terminationReason  String?
  expiresAt          DateTime
  connectedAt        DateTime?
  endedAt            DateTime?
  lastHeartbeatAt    DateTime?
  durationSeconds    Int?
  maxDurationSeconds Int

  participantId   String
  participantName String?
  metadata        Json?
  // Enabled tools at creation time (no signing secrets).
  toolsSnapshot   Json

  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  toolCallCount     Int       @default(0)
  providerCostPaise Int?
  creditsCharged    Int?
  // Credits the balance couldn't cover when the call was billed.
  creditsShortfall  Int?
  usageRecordedAt   DateTime?

  toolInvocations AiToolInvocation[]
  messages        AiConversationMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([agentId, createdAt])
  @@index([usageRecordedAt])
}

enum AiToolInvocationStatus {
  SUCCESS
  FAILED
  TIMEOUT
  REJECTED
  UNCONFIRMED
}

/// One tool call in an AI session. Never stores arguments or responses.
model AiToolInvocation {
  id String @id @default(uuid())

  sessionId String
  session   AiCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Plain id: the tool may be deleted later; the name keeps the row readable.
  toolId    String?
  toolName  String
  status    AiToolInvocationStatus
  latencyMs Int
  errorCode String?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([toolId, createdAt])
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// One final transcript segment, redacted before insert. Only written when
/// the agent's storeTranscript is on; purged after transcriptRetentionDays.
model AiConversationMessage {
  id String @id @default(uuid())

  sessionId String
  session   AiCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    AiMessageRole
  content String

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}


// ══════════════════════════════════════════════════════════
// Live Translate (see apps/server/src/translation/README.md)
// ══════════════════════════════════════════════════════════

enum TranslationMode {
  OFF
  CAPTIONS
  VOICE
}

enum TranslationSessionStatus {
  ACTIVE
  ENDED
  FAILED
}

enum TranslationTermKind {
  DO_NOT_TRANSLATE
  TRANSLATE_AS
  PRONOUNCE_AS
}

enum TranslationReportStatus {
  PENDING
  READY
  FAILED
}

// Per-project translation settings (1:1, created lazily with defaults).
model TranslationSettings {
  id                      String   @id @default(uuid())
  projectId               String   @unique
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // MeaningGuard: original-audio replay is opt-in, off by default.
  replayEnabled           Boolean  @default(false)
  // Post-Call Suite: transcript + report storage is opt-in.
  postCallReportEnabled   Boolean  @default(false)
  sentimentEnabled        Boolean  @default(false)
  transcriptRetentionDays Int      @default(30)
  // PurpleLex call context default (healthcare, legal, saas, finance, ecommerce).
  industry                String?
  defaultLexiconId        String?
  // CostGuard
  defaultMaxMinutes       Int?
  dailyBudgetCredits      Int?
  monthlyBudgetCredits    Int?
  alertThresholds         Int[]    @default([50, 80, 100])
  // "captions_then_off" | "off"
  onLimit                 String   @default("captions_then_off")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// One provider session per direction of a translated call.
model TranslationSession {
  id                  String                   @id @default(uuid())
  callId              String
  call                Call                     @relation(fields: [callId], references: [id], onDelete: Cascade)
  projectId           String
  ownerId             String
  // "caller_to_receiver" | "receiver_to_caller"
  direction           String
  sourceLanguage      String
  targetLanguage      String
  mode                TranslationMode
  // Provider route, e.g. "openai-translate", "sarvam", "mock".
  route               String
  status              TranslationSessionStatus @default(ACTIVE)
  // Rates locked at session start (admin changes apply to new sessions only).
  voiceRate           Int
  captionsRate        Int
  startedAt           DateTime                 @default(now())
  endedAt             DateTime?
  endReason           String?
  voiceSeconds        Int                      @default(0)
  captionsSeconds     Int                      @default(0)
  creditsCharged      Int                      @default(0)
  providerCostPaise   Int                      @default(0)
  trialSecondsUsed    Int                      @default(0)
  usageRecordedAt     DateTime?
  // Observability (per session)
  phrases             Int                      @default(0)
  firstAudioMsP50     Int?
  firstAudioMsP95     Int?
  captionDelayMsP50   Int?
  captionDelayMsP95   Int?
  droppedFrames       Int                      @default(0)
  providerFailures    Int                      @default(0)
  fallbacks           Int                      @default(0)
  flags               Int                      @default(0)
  flagReasons         Json?
  replays             Int                      @default(0)
  repeats             Int                      @default(0)
  lexiconHits         Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([projectId, startedAt])
  @@index([ownerId, startedAt])
  @@index([callId])
  @@index([status, usageRecordedAt])
}

// Phrase transcript, stored only when the project opted into the Post-Call Suite.
model TranslationPhrase {
  id                String    @id @default(uuid())
  callId            String
  call              Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  phraseId          String
  // "caller" | "receiver"
  speaker           String
  sourceLanguage    String
  targetLanguage    String
  original          String
  translated        String
  startedAt         DateTime
  endedAt           DateTime?
  translatedAudioAt DateTime?
  guardStatus       String    @default("ok")
  guardReasons      String[]  @default([])
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@unique([callId, phraseId])
  @@index([expiresAt])
}

model TranslationReport {
  id             String                  @id @default(uuid())
  callId         String                  @unique
  call           Call                    @relation(fields: [callId], references: [id], onDelete: Cascade)
  projectId      String
  status         TranslationReportStatus @default(PENDING)
  // { [lang]: { keyPoints[], decisions[], actionItems[{text, phraseId}] } }
  summary        Json?
  // talk ratio, topics, flagged moments, replays/repeats, optional tone
  signals        Json?
  creditsCharged Int                     @default(0)
  error          String?
  expiresAt      DateTime
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([expiresAt])
}

// PurpleLex
model TranslationLexicon {
  id        String                   @id @default(uuid())
  projectId String
  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  terms     TranslationLexiconTerm[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([projectId])
}

model TranslationLexiconTerm {
  id            String              @id @default(uuid())
  lexiconId     String
  lexicon       TranslationLexicon  @relation(fields: [lexiconId], references: [id], onDelete: Cascade)
  term          String
  kind          TranslationTermKind @default(DO_NOT_TRANSLATE)
  // TRANSLATE_AS: { "hi": "…", "ta": "…" }
  translations  Json?
  // PRONOUNCE_AS: spoken hint for TTS
  pronunciation String?
  caseSensitive Boolean             @default(false)
  createdAt     DateTime            @default(now())

  @@unique([lexiconId, term])
}

// CostGuard: one row per (project, period, threshold) so alerts fire once.
model TranslationBudgetAlert {
  id        String   @id @default(uuid())
  projectId String
  // "day:2026-10-22" | "month:2026-10"
  period    String
  threshold Int
  createdAt DateTime @default(now())

  @@unique([projectId, period, threshold])
}

// Admin-managed per-customer translation price overrides.
model TranslationRateOverride {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceCreditsPerMinute    Int?
  captionsCreditsPerMinute Int?
  postCallReportCredits    Int?
  note                     String?
  updatedById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}


// ══════════════════════════════════════════════════════════
// Prepaid Auto Top-Up (see src/billing/auto-topup/AUTO_TOPUP.md)
// ══════════════════════════════════════════════════════════

enum AutoTopUpMandateStatus {
  NONE
  PENDING
  ACTIVE
  FAILED
  REVOKED
}

enum AutoTopUpAttemptStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AutoTopUpSetting {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled               Boolean                @default(false)
  currency              String                 @default("INR")
  // Trigger when available credits are at or below this.
  thresholdCredits      Int
  // Monetary purchase amount per top-up (before tax), minor units.
  amountPaise           Int
  // Monthly cap on confirmed + in-flight auto top-up charges (incl. tax), minor units.
  monthlyLimitPaise     Int
  // Explicit consent for merchant-initiated charges.
  consentAt             DateTime?
  consentVersion        String?
  // Provider recurring authorization (Razorpay customer + token).
  providerCustomerId    String?
  providerTokenId       String?
  mandateStatus         AutoTopUpMandateStatus @default(NONE)
  mandateMaxAmountPaise Int?
  mandateExpiresAt      DateTime?
  mandateMethod         String?
  // Mandate registration order awaiting the customer's authorization.
  mandateOrderId        String?
  // Set when a charge failed / needs the customer; cleared on success or update.
  attentionReason       String?
  attentionAt           DateTime?
  disabledReason        String?
  lastTriggeredAt       DateTime?
  lastSucceededAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  attempts AutoTopUpAttempt[]

  @@index([enabled, mandateStatus])
}

model AutoTopUpAttempt {
  id                     String                 @id @default(uuid())
  userId                 String
  settingId              String
  setting                AutoTopUpSetting       @relation(fields: [settingId], references: [id], onDelete: Cascade)
  // Exactly one Payment per attempt (snapshot of price, tax, credits).
  paymentId              String?                @unique
  idempotencyKey         String                 @unique
  status                 AutoTopUpAttemptStatus @default(PENDING)
  amountPaise            Int
  taxPaise               Int
  totalPaise             Int
  credits                Int
  currency               String                 @default("INR")
  creditPricingVersionId String
  creditPricePaise       Int
  triggerBalance         Int
  // UTC "YYYY-MM" for monthly spending limits.
  monthKey               String
  retryOfId              String?
  retryCount             Int                    @default(0)
  nextRetryAt            DateTime?
  providerPaymentId      String?
  failureCode            String?
  failureReason          String?
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([userId, status])
  @@index([userId, monthKey])
  @@index([status, nextRetryAt])
}
