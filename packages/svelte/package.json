{
  "name": "@purplecallio/svelte",
  "version": "0.1.0",
  "description": "Official Svelte stores and components for PurpleCallio, a developer-focused real-time communication infrastructure platform for voice, video, screen sharing and WebRTC applications.",
  "homepage": "https://purplecallio.com",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package",
    "dev": "svelte-package --watch",
    "test": "vitest run"
  },
  "keywords": [
    "purplecallio",
    "svelte",
    "video",
    "webrtc",
    "voice",
    "real-time",
    "sdk",
    "typescript",
    "stores"
  ],
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@purplecallio/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.1",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
