# ── Public host ───────────────────────────────────────────────────────────────
# The ONE place the domain lives. Nginx server_name, TLS certificate paths,
# the web build and TURN all derive from it. Changing domain = change this,
# get a certificate for it, rebuild web (see DEPLOYMENT.md).
# Must be a bare DNS name with a certificate at /etc/letsencrypt/live/<PUBLIC_HOST>/.
PUBLIC_HOST=purplecallio.serveminecraft.net
# Derived by docker-compose.yml; set only to override:
#   FRONTEND_URL / APP_URL  = https://$PUBLIC_HOST
#   NEXT_PUBLIC_API_URL     = https://$PUBLIC_HOST/api   (REST; Socket.IO is /socket.io/ on the same host)
#   NEXT_PUBLIC_SITE_URL    = https://$PUBLIC_HOST       (canonical URLs, sitemap)
#   TURN_HOST               = $PUBLIC_HOST               (turn:3478 / turns:5349)

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<long-random-password>
POSTGRES_DB=<database-name>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=<long-random-secret>
JWT_REFRESH_SECRET=<different-long-random-secret>
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Public: defaults to GOOGLE_CLIENT_ID if left unset.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── TURN (Coturn, host networking) ────────────────────────────────────────────
# TURN_HOST defaults to PUBLIC_HOST. Override only for a separate TURN name,
# which then needs its own certificate at /etc/letsencrypt/live/<TURN_HOST>/.
# TURN_HOST=
# Public IPv4 Coturn advertises in relay candidates (OCI instance public IP).
TURN_EXTERNAL_IP=<public-ipv4>
# TURN_SERVER is legacy (older configs used it for both); leave it unset.
TURN_SECRET=<long-random-shared-secret>
# Customer TURN credential lifetime. Keep it longer than your longest call:
# Coturn rechecks it on allocation refresh.
TURN_CREDENTIAL_TTL_SECONDS=86400
# Global Coturn ceilings, shared by ALL traffic (customer and Playground).
TURN_TOTAL_QUOTA=64
TURN_MAX_BPS=4000000
TURN_BPS_CAPACITY=8000000
# Only if the certificate lives elsewhere:
# TURN_TLS_CERT_FILE=/etc/letsencrypt/live/<TURN_HOST>/fullchain.pem
# TURN_TLS_KEY_FILE=/etc/letsencrypt/live/<TURN_HOST>/privkey.pem

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<rzp_live_key_id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
# Public: defaults to RAZORPAY_KEY_ID if left unset.
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay webhook URL: https://<PUBLIC_HOST>/api/billing/webhook
# Events: payment.captured, payment.failed, order.paid, refund.processed,
# payment.dispute.created. Plan prices, credits and top-ups are configured
# in Admin → Billing (database), not here.

# ── App behaviour ─────────────────────────────────────────────────────────────
PAGE_SIZE=10
CALL_RING_TIMEOUT_MS=30000
# In-app notification retention (days; minimum 30, enforced server-side).
NOTIFICATION_READ_RETENTION_DAYS=90
NOTIFICATION_UNREAD_RETENTION_DAYS=180

# ── Playground (defaults shown; all enforced server-side) ─────────────────────
PLAYGROUND_ENABLED=true
PLAYGROUND_CALL_DURATION_SECONDS=60
PLAYGROUND_IDLE_TIMEOUT_SECONDS=30
PLAYGROUND_MAX_PARTICIPANTS=2
PLAYGROUND_MAX_ACTIVE_CALLS_PER_IP=1
PLAYGROUND_MAX_ACTIVE_CALLS_PER_IDENTITY=1
PLAYGROUND_CALL_RATE_LIMIT_MAX=5
PLAYGROUND_CALL_RATE_LIMIT_WINDOW_SECONDS=600
PLAYGROUND_DAILY_CALL_LIMIT=20
PLAYGROUND_MAX_ACTIVE_CALLS_GLOBAL=5
PLAYGROUND_PARTICIPANT_TOKEN_TTL_SECONDS=180
PLAYGROUND_TURN_CREDENTIAL_TTL_SECONDS=60
PLAYGROUND_TURN_CALLS_PER_MINUTE=3
PLAYGROUND_SOCKET_EVENTS_PER_MINUTE=120

# ── Socket.IO abuse limits (all traffic) ──────────────────────────────────────
SOCKET_AUTH_ATTEMPTS_PER_MINUTE=20
SOCKET_MAX_UNAUTHENTICATED_CONNECTIONS=100
